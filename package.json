{
  "name": "@okrlinkhub/kpi-convex",
  "version": "0.1.0",
  "description": "Single-source KPI catalog, projections, live detail and reusable React UI for Convex applications.",
  "repository": "github:okrlinkhub/kpi-convex",
  "homepage": "https://github.com/okrlinkhub/kpi-convex#readme",
  "bugs": { "url": "https://github.com/okrlinkhub/kpi-convex/issues" },
  "license": "Apache-2.0",
  "keywords": ["convex", "component", "kpi", "clickhouse", "cloudflare-r2", "react"],
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "dev": "convex dev --start 'pnpm dev:build'",
    "dev:frontend": "pnpm --dir example dev",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.{ts,tsx,css}' -i '**/*.test.*' -c 'pnpm build:codegen' --initial",
    "predev": "convex init && pnpm build:codegen",
    "build": "tsc --project ./tsconfig.build.json && cp src/react/styles.css dist/react/styles.css",
    "build:codegen": "convex codegen --component-dir ./src/component && pnpm build",
    "build:clean": "rm -rf dist *.tsbuildinfo && pnpm build:codegen",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example/tsconfig.json && tsc --noEmit -p example/convex/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm build && vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "prepare": "pnpm build",
    "preversion": "pnpm install --frozen-lockfile && pnpm build:clean && pnpm test && pnpm lint && pnpm typecheck"
  },
  "files": ["CHANGELOG.md", "dist", "src"],
  "exports": {
    "./package.json": "./package.json",
    ".": { "types": "./dist/client/index.d.ts", "default": "./dist/client/index.js" },
    "./server": { "types": "./dist/client/index.d.ts", "default": "./dist/client/index.js" },
    "./contracts": { "types": "./dist/contracts/index.d.ts", "default": "./dist/contracts/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "default": "./dist/react/index.js" },
    "./styles.css": "./dist/react/styles.css",
    "./test": { "types": "./dist/test.d.ts", "default": "./dist/test.js" },
    "./_generated/component.js": { "types": "./dist/component/_generated/component.d.ts" },
    "./_generated/component": { "types": "./dist/component/_generated/component.d.ts" },
    "./convex.config.js": { "types": "./dist/component/convex.config.d.ts", "default": "./dist/component/convex.config.js" },
    "./convex.config": { "types": "./dist/component/convex.config.d.ts", "default": "./dist/component/convex.config.js" }
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "aws4fetch": "^1.0.20"
  },
  "peerDependencies": {
    "convex": "^1.44.0",
    "lucide-react": ">=0.468.0 <1",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "chokidar-cli": "3.0.0",
    "convex": "^1.44.0",
    "convex-test": "0.0.55",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "prettier": "3.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
